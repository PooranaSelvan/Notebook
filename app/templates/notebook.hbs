{{page-title "Notebook"}}
<div class="flex flex-wrap justify-center flex-col gap-10 w-full relative p-10">
     <LinkTo @route="notebooks" class="absolute top-10 right-10 z-10 p-2 rounded-full bg-red-400 cursor-pointer text-black">
          <img src="/images/close.svg" alt="ok" class="h-7 w-7" />
     </LinkTo>
     {{#if this.notebook.isCreatorForm}}
     <div class="flex flex-wrap items-center gap-10 mt-12">
          <Note @onClose={{this.updateCreatorForm}} @updateName={{this.updateNoteName}}
               @updateContent={{this.updateNoteContent}} @createNotePad={{this.createNotePad}}
               @notebookId={{@model.notebookId}} />
     </div>
     {{else}}
     <div class="flex flex-wrap justify-center flex-col gap-5 mt-12">
          {{#if @model.notebook.notes.length}}
               <div class="py-6 flex flex-wrap items-center justify-between gap-4 w-full">
                    <div class=" flex flex-wrap items-center gap-4">
                         <div>
                              <p class="text-gray-400 text-sm">Notebook</p>
                              <h2 class="text-white text-2xl font-bold tracking-wide">
                                   {{@model.notebook.name}}
                              </h2>
                              <p class="text-gray-500 text-sm mt-1">
                                   {{@model.notebook.notes.length}} notes
                              </p>
                         </div>

                         <div class="w-full md:w-auto">
                              <input type="text" placeholder="Search notes..." class="text-white placeholder-gray-400 border border-gray-700 outline-none px-5 py-2.5 rounded-xl" {{on "input" this.searchNotePad}} />
                         </div>
                    </div>
                    <div>
                         <LinkTo @route="notebook-settings" @model={{@model.notebook.id}} class="text-white cursor-pointer">
                              <img src="/images/gear.svg" alt="ok" class="h-11 w-11" />
                         </LinkTo>
                    </div>
               </div>
          {{/if}}

          <div class="flex flex-wrap items-center gap-10">
               {{#if this.isSearching}}
                    {{#each this.filteredNotebook as |note|}}
                         <Notecard @note={{note}} @deleteNotePad={{this.deleteNotepad}} />
                    {{/each}}     
               {{else}}
                    {{#each @model.notebook.notes as |note|}}
                         <Notecard @note={{note}} @deleteNotePad={{this.deleteNotepad}} />
                    {{/each}}
               {{/if}}
          </div>
     </div>

     <div class="absolute top-10 left-10">
          <button type="button" class="px-10 py-3 rounded-sm bg-fuchsia-200 cursor-pointer text-black" {{on "click" this.updateCreatorForm}}>
               Create NotePad
          </button>
     </div>
     {{/if}}
</div>
{{outlet}}